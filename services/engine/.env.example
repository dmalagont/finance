# Postgres connection with a role that bypasses RLS (Supabase: the "postgres" user via the
# session pooler, or a dedicated engine role). Never expose this to the browser.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres

# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Shared secret between the Cloudflare Worker and the engine API (long random string).
ENGINE_API_TOKEN=

# Optional
# ENGINE_HISTORY_START=1990-01-01
# ENGINE_HTTP_TIMEOUT=30
